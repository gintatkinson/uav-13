    doc /* Synthesized deterministic package lifecycle state machine. */
    state def Interface_Table_LifecycleState {
        state Interface_Table_System_State;
        state Interface_Table_InitState;
        state Interface_Table_ActiveState;
        transition Initial_to_Interface_Table_System_State first Initial then Interface_Table_System_State;
        transition Interface_Table_System_State_to_Interface_Table_InitState_on_Initialize_Interface_Table first Interface_Table_System_State accept Initialize_Interface_Table then Interface_Table_InitState;
        transition Interface_Table_InitState_to_Interface_Table_ActiveState_on_Verify_Interface_Table first Interface_Table_InitState accept Verify_Interface_Table then Interface_Table_ActiveState;
        transition Interface_Table_ActiveState_to_Terminal first Interface_Table_ActiveState then Terminal;
    }
    doc /* Synthesized deterministic package lifecycle state machine. */
    state def OEM_Bill_of_Materials_LifecycleState {
        state Air_Vehicle_Avenger_V2_5_State;
        state Airframe_Fuselage_State;
        state Airframe_Payload_Bay_State;
        transition Initial_to_Air_Vehicle_Avenger_V2_5_State first Initial then Air_Vehicle_Avenger_V2_5_State;
        transition Air_Vehicle_Avenger_V2_5_State_to_Airframe_Fuselage_State_on_Initialize_OEM_Bill_of_Materials first Air_Vehicle_Avenger_V2_5_State accept Initialize_OEM_Bill_of_Materials then Airframe_Fuselage_State;
        transition Airframe_Fuselage_State_to_Airframe_Payload_Bay_State_on_Verify_OEM_Bill_of_Materials first Airframe_Fuselage_State accept Verify_OEM_Bill_of_Materials then Airframe_Payload_Bay_State;
        transition Airframe_Payload_Bay_State_to_Terminal first Airframe_Payload_Bay_State then Terminal;
    }
    doc /* Synthesized deterministic package lifecycle state machine. */
    state def Parametric_Limits_Table_LifecycleState {
        state Parametric_Limits_Table_System_State;
        state Parametric_Limits_Table_InitState;
        state Parametric_Limits_Table_ActiveState;
        transition Initial_to_Parametric_Limits_Table_System_State first Initial then Parametric_Limits_Table_System_State;
        transition Parametric_Limits_Table_System_State_to_Parametric_Limits_Table_InitState_on_Initialize_Parametric_Limits_Table first Parametric_Limits_Table_System_State accept Initialize_Parametric_Limits_Table then Parametric_Limits_Table_InitState;
        transition Parametric_Limits_Table_InitState_to_Parametric_Limits_Table_ActiveState_on_Verify_Parametric_Limits_Table first Parametric_Limits_Table_InitState accept Verify_Parametric_Limits_Table then Parametric_Limits_Table_ActiveState;
        transition Parametric_Limits_Table_ActiveState_to_Terminal first Parametric_Limits_Table_ActiveState then Terminal;
    }
